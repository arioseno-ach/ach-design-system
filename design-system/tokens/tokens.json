{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "ach-design-system",
    "version": "0.1.0",
    "description": "Source of truth for design tokens. Edit this file; generate tokens.css from it."
  },
  "color": {
    "neutral": {
      "0": { "$value": "#FFFFFF", "$type": "color" },
      "50": { "$value": "#F7F7F8", "$type": "color" },
      "100": { "$value": "#EEEEF0", "$type": "color" },
      "200": { "$value": "#D9D9DE", "$type": "color" },
      "400": { "$value": "#8B8B96", "$type": "color" },
      "600": { "$value": "#4A4A55", "$type": "color" },
      "800": { "$value": "#1F1F24", "$type": "color" },
      "900": { "$value": "#111114", "$type": "color" }
    },
    "brand": {
      "100": { "$value": "#E8EEF8", "$type": "color" },
      "500": { "$value": "#1F4EA3", "$type": "color" },
      "600": { "$value": "#173B7C", "$type": "color" }
    },
    "feedback": {
      "success": { "$value": "#1B7A4E", "$type": "color" },
      "warning": { "$value": "#B36B00", "$type": "color" },
      "danger": { "$value": "#B42318", "$type": "color" }
    }
  },
  "space": {
    "0": { "$value": "0px", "$type": "dimension" },
    "4": { "$value": "4px", "$type": "dimension" },
    "8": { "$value": "8px", "$type": "dimension" },
    "12": { "$value": "12px", "$type": "dimension" },
    "16": { "$value": "16px", "$type": "dimension" },
    "24": { "$value": "24px", "$type": "dimension" },
    "32": { "$value": "32px", "$type": "dimension" },
    "48": { "$value": "48px", "$type": "dimension" }
  },
  "font": {
    "family": {
      "sans": { "$value": "Inter, system-ui, sans-serif", "$type": "fontFamily" }
    },
    "size": {
      "sm": { "$value": "14px", "$type": "dimension" },
      "md": { "$value": "16px", "$type": "dimension" },
      "lg": { "$value": "20px", "$type": "dimension" },
      "xl": { "$value": "24px", "$type": "dimension" }
    },
    "weight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium": { "$value": "500", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" }
    },
    "lineHeight": {
      "tight": { "$value": "1.25", "$type": "number" },
      "normal": { "$value": "1.5", "$type": "number" }
    }
  },
  "radius": {
    "sm": { "$value": "4px", "$type": "dimension" },
    "md": { "$value": "8px", "$type": "dimension" },
    "lg": { "$value": "12px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  }
}
